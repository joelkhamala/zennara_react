# ===================================================
# ZENNARA Backend Environment Configuration (.env)
# ===================================================

# --- Email (SMTP) Configuration ---
# For Gmail: Use your Gmail address and a 16-character Google App Password (not your normal password)
# How to get Google App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
FROM_EMAIL=noreply@zennarafp.com
TEAM_EMAIL=info@zennarafp.com

# --- SMS (Twilio) Configuration ---
# Optional: Required if you want OTPs sent as real SMS to mobile phones
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Security & Admin ---
ADMIN_PASSWORD=admin123
ENCRYPTION_KEY=your-secret-encryption-key-change-this-32-chars
CRM_SYNC_ENABLED=true
