# ZENNARA React Application Environment Variables
# Copy this file to .env.local for development, .env.production for production

# API Configuration
VITE_API_URL=https://api.zennara.com/v1
# For development with mock data, leave empty or set to mock
# VITE_API_URL=http://localhost:3001/api

# Site Configuration
VITE_SITE_NAME=ZENNARA
VITE_SITE_DESCRIPTION=Luxury Real Estate & Investment Advisory
VITE_SITE_URL=https://zennara.com

# Optional Analytics & Services
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# VITE_STRIPE_PUBLIC_KEY=pk_live_xxxxx

# Feature Flags
VITE_ENABLE_MAINTENANCE=false
VITE_ENABLE_REGISTRATION=true
