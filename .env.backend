# =====================================================
# ZENNARA Backend Configuration
# Copy this file to .env.backend and update with real values
# =====================================================

# SMTP Configuration (Email Sending)
# For Gmail:
#   1. Enable 2-Factor Authentication
#   2. Generate "App password" from https://myaccount.google.com/apppasswords
#   3. Use the 16-character app password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=khamalawanyoa@gmail.com
SMTP_PASS=ttmz wwsc hmif heqy
FROM_EMAIL=info@zennarafp.com
TEAM_EMAIL=info@zennarafp.com
FROM_NAME=ZENNARA

# SMS Configuration (Africa's Talking - Primary Kenya Gateway)
SMS_PROVIDER=africastalking
AT_USERNAME=Zannara
AT_API_KEY=atsk_302790bd5d44e74a3613669073061bb2a6cb66ee618e21633d2c5f375c7e9ea858b08c75
AT_SENDER_ID=



# CRM Integration Configuration

## Zapier Webhook (Recommended for easy integration)
# Create a Zap in Zapier with webhook trigger
# Copy your webhook URL here
ZAPIER_WEBHOOK_URL=

## HubSpot API Integration
# Get API key from https://app.hubspot.com/l/settings/integrations/private-apps
HUBSPOT_API_KEY=
HUBSPOT_PIPELINE_ID=default

## Salesforce Integration
# Get OAuth credentials from your Salesforce instance
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_ENDPOINT=https://login.salesforce.com

## Enable/Disable CRM Sync
CRM_SYNC_ENABLED=true

# Security Configuration

## Encryption Key (Change to random string!)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-this-to-a-random-string-at-least-32-characters-long

## Admin Password (Change this!)
# Used for accessing /backend/admin.php dashboard
ADMIN_PASSWORD=admin123

## Team Email (Where admin notifications go)
TEAM_EMAIL=info@zennarafp.com

# =====================================================
# Setup Instructions:
# =====================================================
# 
# 1. Copy this file to .env.backend:
#    cp .env.backend.example .env.backend
#
# 2. Update SMTP_USER and SMTP_PASS with your email credentials
#
# 3. (Optional) Setup Twilio for SMS verification:
#    - Sign up at https://www.twilio.com
#    - Get Account SID, Auth Token, and a phone number
#    - Add to TWILIO_* variables
#
# 4. (Optional) Setup CRM Integration:
#    - Zapier: Easiest - just add webhook URL
#    - HubSpot: Add API key from private apps
#    - Salesforce: Add OAuth credentials
#
# 5. Generate encryption key:
#    openssl rand -base64 32
#    Copy output to ENCRYPTION_KEY
#
# 6. Change ADMIN_PASSWORD to something strong
#
# 7. Start PHP server in project root:
#    php -S localhost:8000 -t .
#
# 8. Vite dev server will proxy /backend to localhost:8000
#
# 9. Test at:
#    http://localhost:3000       (React frontend)
#    http://localhost:3000/backend/admin.php (Admin dashboard)
#    http://localhost:3000/backend/analytics.php (Analytics)
#    http://localhost:3000/backend/logs.php (Logs viewer)
#
# =====================================================
# Environment Variables (Optional - for advanced users):
# =====================================================
# These are read from the system environment variables.
# You can also add them to your .env.backend file above.
# The .env.backend file takes precedence over system env vars.
# =====================================================
